# Copy to .env for local development. Values here override nothing set in the shell.
CUE_DATABASE__URL=sqlite+aiosqlite:///./cue.db
CUE_WORKER__EMBEDDED=true
CUE_CHANNELS__PUSH__PROVIDER=console
CUE_CHANNELS__SMS__PROVIDER=console

# Optional AI personalisation
# CUE_AI__ENABLED=true
# CUE_AI__MODEL=openai:gpt-5-mini
# OPENAI_API_KEY=sk-...
